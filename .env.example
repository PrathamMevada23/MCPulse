# Server-side values only. Do not put credentials or secrets in this file.
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://mcpulse:mcpulse_local_only@127.0.0.1:5432/mcpulse
CHECK_TIMEOUT_MS=10000
INCIDENT_FAILURE_THRESHOLD=3

# Absolute path to the Amazon RDS CA bundle. Required when the database host
# is an RDS endpoint: TLS is verified against this CA and the certificate
# hostname is checked. The deployment mounts the bundle read only.
RDS_CA_BUNDLE_PATH=/etc/ssl/certs/rds-ca-global-bundle.pem

# Optional shared secret for administrative routes (manual check, tool
# discovery/test, outage simulation, server deletion). Leave unset when the
# API is only reachable through the reverse proxy allowlist.
# ADMIN_API_KEY=replace-with-at-least-16-random-characters

# Browser-safe build-time setting. Never prefix secrets with VITE_.
# Leave unset to call the API on the same origin (recommended).
VITE_API_BASE_URL=http://localhost:3001

# Address allowed to perform state changing API operations through nginx.
# MCPULSE_ADMIN_IP=203.0.113.10
